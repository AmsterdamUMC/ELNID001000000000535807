# ── Final targets ──────────────────────────────────────────────────────────────
rule all:
    input:
        # ATAC-seq outputs
        expand("{outdir}/atac/{comparison}/differential_peaks.csv",        outdir=config["output_dir"], comparison=COMPARISONS.keys()),
        expand("{outdir}/atac/{comparison}/annotated_peaks.csv",           outdir=config["output_dir"], comparison=COMPARISONS.keys()),
