        expand("{outdir}/atac/{comparison}/GREAT_{database}_down.csv",                outdir=config["output_dir"], comparison=COMPARISONS.keys(), database=ATAC_DATABASES.keys()),
        expand("{outdir}/atac/{comparison}/GREAT_{database}_up_dotplot.png",          outdir=config["output_dir"], comparison=COMPARISONS.keys(), database=ATAC_DATABASES.keys()),
        expand("{outdir}/atac/{comparison}/GREAT_{database}_down_dotplot.png",        outdir=config["output_dir"], comparison=COMPARISONS.keys(), database=ATAC_DATABASES.keys()),
